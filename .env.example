# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
PGHOST=localhost
PGPORT=5432
PGUSER=your_database_user
PGPASSWORD=your_database_password
PGDATABASE=unlock_srq

# Server Configuration
PORT=5000
NODE_ENV=production

# Session Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-random-string-here-change-this

# Optional: Stripe Payment Integration
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Calendly Integration
# Your Calendly username for booking integration
CALENDLY_USERNAME=your-calendly-username

# Optional: Google Analytics
# Already configured in client/index.html (G-R0JFDJZ0MW)
